# Gemini API key for AI triage, semantic deduplication, and admin briefings
# Optional: when unset, the backend uses deterministic rule-based fallbacks.
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Optional Firebase Admin credentials (if enabling Firestore persistence)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
